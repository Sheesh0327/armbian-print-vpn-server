[Unit]
Description=Hardened Web Print Server for Armbian
After=network.target cups.service
Requires=cups.service

[Service]
Type=simple
User=webprint
Group=webprint
SupplementaryGroups=lp
WorkingDirectory=/opt/webprint
Environment=PORT=80
ExecStart=/usr/bin/gunicorn --bind 0.0.0.0:80 --workers 2 --timeout 120 --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=5

# Security Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/webprint /var/spool/webprint /tmp
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
