# Normalize line endings to LF across all platforms
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.env text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
